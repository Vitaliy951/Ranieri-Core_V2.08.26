# Безопасность
ALLOWED_ORIGINS=http://localhost:8000,https://your-domain.ru
SECRET_KEY=your-secret-key-here
API_KEY_HEADER=X-API-Key

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=cctech_audit_secure
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=secure_pass

# Внешние агрегаторы (заменить на реальные ключи)
KONTUR_API_KEY=your-kontur-key
KONTUR_API_URL=https://api.kontur.ru
SMEV_GATEWAY_URL=https://smev.gov.ru
SMEV_CERT_PATH=/certs/smev.pem

# Логирование
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
